# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API). NUNCA envie o .env.local ao Git.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Chave service_role: usada SOMENTE no servidor para criar usuarios (menu Usuarios).
# Nunca coloque o prefixo NEXT_PUBLIC_ nesta variavel.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# Dados da empresa exibidos na proposta
COMPANY_NAME="SuperSeg Medicina e Segurança do Trabalho"
COMPANY_CNPJ=
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_SITE=
